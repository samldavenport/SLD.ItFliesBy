# The engine, gui, and exe are unity builds, so compile_commands.json only has
# entries for eng.cpp, gui.cpp, and game-win32-main.cpp. For every other file clangd
# borrows the command of whichever entry looks closest, and for IFB.Core that
# is SLD.Core's sld.cpp, which has none of the other sld include paths.
#
# Paths are relative to the build directory (build/<preset>).
If:
  PathMatch: IFB\.(Core|Engine|GUI|Game)/.*
CompileFlags:
  Add:
    - -I../../IFB.Core/include
    - -I../../IFB.Engine/include
    - -I../../IFB.GUI/src
    - -I../../IFB.Game/src
    - -I../../SLD.Core/include
    - -I../../SLD.OpenGL/include
    - -I../../SLD.Math/include
    - -I../../SLD.Strings/include
    - -I../../IFB.Engine/src/collections
    - -I../../IFB.Engine/src/components
    - -I../../IFB.Engine/src/engine
    - -I../../IFB.Engine/src/entities
    - -I../../IFB.Engine/src/files
    - -I../../IFB.Engine/src/json
    - -I../../IFB.Engine/src/map
    - -I../../IFB.Engine/src/memory
    - -I../../IFB.Engine/src/particle
    - -I../../IFB.Engine/src/physics
    - -I../../IFB.Engine/src/quads
    - -I../../IFB.Engine/src/renderer
    - -I../../IFB.Engine/src/tiled
    - -I../../IFB.Engine/src/win32
    - -Ivcpkg_installed/x64-windows/include
    - -DIFB_ENGINE_DLL_EXPORT
    - -DIFB_API_DLL_EXPORT
---
# SLD.Math is header only, so it has no entry in compile_commands.json at all.
If:
  PathMatch: SLD\.Math/(include|src)/.*
CompileFlags:
  Add:
    - -I../../SLD.Math/include
    - -I../../SLD.Math/src
    - -I../../SLD.Core/include
